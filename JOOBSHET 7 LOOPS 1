3.1 Assignment 1: Cinema Ticket Sales
Tickets cost Rp50,000 each. A customer receives a 10% discount when buying more than 4 tickets and a 15% discount 
when buying more than 10 tickets. Negative quantities are invalid and must be entered again. The program calculates 
the total number of tickets sold and the total revenue for the day.

3.1.1 Java Program Code
import java.util.Scanner;

public class CinemaSales05 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        final int ticketPrice = 50000;
        int totalTickets = 0;
        double totalRevenue = 0;
        String again;

        do {
            int quantity;
            do {
                System.out.print("Enter ticket quantity (0 to finish this sales session): ");
                quantity = sc.nextInt();
                if (quantity < 0) {
                    System.out.println("Invalid quantity. Please enter a non-negative number.");
                }
            } while (quantity < 0);

            if (quantity == 0) {
                break;
            }

            double discountRate = 0;
            if (quantity > 10) {
                discountRate = 0.15;
            } else if (quantity > 4) {
                discountRate = 0.10;
            }

            double subtotal = (double) quantity * ticketPrice;
            double payment = subtotal * (1 - discountRate);
            totalTickets += quantity;
            totalRevenue += payment;

            System.out.printf("Discount: %.0f%%%n", discountRate * 100);
            System.out.printf("Amount to pay: Rp %.0f%n", payment);
            System.out.print("Process another customer? (yes/no): ");
            again = sc.next();
        } while (again.equalsIgnoreCase("yes"));

        System.out.println("Total tickets sold: " + totalTickets);
        System.out.printf("Total ticket sales revenue: Rp %.0f%n", totalRevenue);
        sc.close();
    }
}
