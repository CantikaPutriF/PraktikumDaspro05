2.3 Experiment 3: Café Transaction Case Study — DO-WHILE Loop
The cashier enters a customer's name and the quantities of coffee, tea, and bread. Coffee costs Rp12,000,
tea costs Rp7,000, and bread costs Rp20,000. The program calculates the total transaction. Entering cancel ends the program.

2.3.1 Java Program Code
import java.util.Scanner;

public class CafeDoWhile264107020237 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        final int coffeePrice = 12000;
        final int teaPrice = 8000;
        final int breadPrice = 5000;
        String customerName;

        do {
            System.out.print("Enter customer name (type 'cancel' to exit): ");
            customerName = sc.nextLine();
            if (customerName.equalsIgnoreCase("cancel")) {
                System.out.println("Transaction canceled.");
                break;
            }

            System.out.print("Coffee quantity: ");
            int coffee = sc.nextInt();
            System.out.print("Tea quantity: ");
            int tea = sc.nextInt();
            System.out.print("Bread quantity: ");
            int bread = sc.nextInt();

            int totalPrice = (coffee * coffeePrice) + (tea * teaPrice) + (bread * breadPrice);
            System.out.println("Total amount to pay: Rp " + totalPrice);
            sc.nextLine();
        } while (true);

        System.out.println("All transactions completed.");
        sc.close();
    }
}
        
